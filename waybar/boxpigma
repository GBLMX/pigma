#!/usr/bin/env bash

# 环境变量:
#   BOXPIGMA_BIN   boxpigma 二进制 (默认 boxpigma)
#   BOXPIGMA_ARGS  daemon 附加参数 (默认 -d)
#   BOXPIGMA_LOG   daemon 日志 (默认 ~/.cache/boxpigma/waybar-daemon.log)
#   BOXPIGMA_LOCK  启动互斥锁文件

BOXPIGMA_BIN="${BOXPIGMA_BIN:-boxpigma}"
BOXPIGMA_ARGS="${BOXPIGMA_ARGS:--d}"
BOXPIGMA_LOG="${BOXPIGMA_LOG:-${XDG_CACHE_HOME:-$HOME/.cache}/boxpigma/waybar-daemon.log}"
BOXPIGMA_LOCK="${XDG_RUNTIME_DIR:-/tmp}/boxpigma-waybar.lock"

fmt_time() {
    local ms=$1
    printf "%d:%02d" $((ms / 60000)) $(((ms % 60000) / 1000))
}

ensure_daemon() {
    "$BOXPIGMA_BIN" status >/dev/null 2>&1 && return 0
    (
        flock -n 9 || return 0
        "$BOXPIGMA_BIN" status >/dev/null 2>&1 && return 0
        mkdir -p "$(dirname "$BOXPIGMA_LOG")"
        setsid "$BOXPIGMA_BIN" $BOXPIGMA_ARGS >>"$BOXPIGMA_LOG" 2>&1 </dev/null &
    ) 9>"$BOXPIGMA_LOCK"
}

toggle() {
    state=$("$BOXPIGMA_BIN" status --json 2>/dev/null)
    playing=$(jq -r '.playing // false' <<<"$state" 2>/dev/null)
    paused=$(jq -r '.paused // false' <<<"$state" 2>/dev/null)
    if [ "$playing" = "true" ] && [ "$paused" = "false" ]; then
        "$BOXPIGMA_BIN" msg pause
    else
        "$BOXPIGMA_BIN" msg play
    fi
}

case "${1:-}" in
"--toggle")
    ensure_daemon
    toggle
    exit 0
    ;;
"--previous")
    ensure_daemon
    "$BOXPIGMA_BIN" msg previous 2>/dev/null
    exit 0
    ;;
"--next")
    ensure_daemon
    "$BOXPIGMA_BIN" msg next 2>/dev/null
    exit 0
    ;;
"--like")
    ensure_daemon
    "$BOXPIGMA_BIN" msg toggle_like 2>/dev/null
    exit 0
    ;;
"--icon")
    case "${2:-}" in
    "prev") text=""; cls="button" ;;
    "next") text=""; cls="button" ;;
    "play")
        ensure_daemon
        state=$("$BOXPIGMA_BIN" status --json 2>/dev/null)
        playing=$(jq -r '.playing // false' <<<"$state" 2>/dev/null)
        paused=$(jq -r '.paused // false' <<<"$state" 2>/dev/null)
        if [ "$playing" = "true" ] && [ "$paused" = "false" ]; then
            text="⏸"
            cls="button"
        else
            text="▶"
            cls="button"
        fi
        ;;
    "like")
        ensure_daemon
        state=$("$BOXPIGMA_BIN" status --json 2>/dev/null)
        liked=$(jq -r '.liked // false' <<<"$state" 2>/dev/null)
        if [ "$liked" = "true" ]; then
            text=""
            cls="button liked"
        else
            text=""
            cls="button"
        fi
        ;;
    *) text="♪"; cls="button" ;;
    esac
    echo "{\"text\":\"$text\",\"class\":\"$cls\"}"
    exit 0
    ;;
esac

ensure_daemon

state=$("$BOXPIGMA_BIN" status --json 2>/dev/null)
if [ -z "$state" ]; then
    echo '{"text":"♪  off","class":"off","tooltip":"boxpigma is not running","alt":"off"}'
    exit 0
fi

# 单次 jq 提取全部字段，逐行输出避免空格分词
mapfile -t f < <(jq -r '[.name // "", .artist // "", .album // "", .playing, .paused, .position_ms, .duration_ms, .volume, .mode // "", .liked] | .[]' <<<"$state" 2>/dev/null)
name="${f[0]}" artist="${f[1]}" album="${f[2]}"
playing="${f[3]}" paused="${f[4]}"
position="${f[5]}" duration="${f[6]}"
volume="${f[7]}" mode="${f[8]}" liked="${f[9]}"

if [ -z "$name" ]; then
    echo '{"text":"♪  idle","class":"idle","tooltip":"no song playing","alt":"idle"}'
    exit 0
fi

if [ "$playing" = "true" ]; then
    if [ "$paused" = "true" ]; then
        icon="⏸"
        cls="paused"
        alt="paused"
    else
        icon="▶"
        cls="playing"
        alt="playing"
    fi
else
    icon="■"
    cls="stopped"
    alt="stopped"
fi

if [ "$liked" = "true" ]; then
    heart=""
else
    heart=""
fi
vol_pct=$(awk -v v="$volume" 'BEGIN{printf "%.0f", v*100}')

# 跑马灯：仅播放中且文字超长时按时间滚动（BOXPIGMA_WINDOW 窗口字符数, BOXPIGMA_SPEED 每秒字符数）；
# 暂停/停止/长度合适时静态显示全名，不额外耗性能。
full="$name — $artist"
len=${#full}
win="${BOXPIGMA_WINDOW:-20}"
if [ "$playing" = "true" ] && [ "$paused" != "true" ] && [ "$len" -gt "$win" ]; then
    speed="${BOXPIGMA_SPEED:-7}"
    gap=8
    span=$((len + gap))
    now_ms=$(( $(date +%s%N) / 1000000 ))
    pos=$(( (now_ms / 1000 * speed) % span ))
    doubled="${full}$(printf '%*s' "$gap" '')${full}"
    text="$icon ${doubled:$pos:$win}"
else
    text="$icon $full"
fi

tooltip="$name
$artist — $album
$(fmt_time "$position") / $(fmt_time "$duration") · vol ${vol_pct}% · $mode ${heart}"

jq -c -n \
    --arg text "$text" \
    --arg tooltip "$tooltip" \
    --arg class "$cls" \
    --arg alt "$alt" \
    '{text:$text, tooltip:$tooltip, class:$class, alt:$alt}'