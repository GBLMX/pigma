{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 50,
  "modules-left": [
    "group/boxpigma"
  ],
  "group/boxpigma": {
    "orientation": "horizontal",
    "modules": [
      "custom/boxpigma",
      "custom/boxpigma#like",
      "custom/boxpigma#prev",
      "custom/boxpigma#play",
      "custom/boxpigma#next"
    ],
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": true,
      "children-class": "drawer-child"
    }
  },
  "custom/boxpigma": {
    "exec": "~/.config/waybar/scripts/boxpigma",
    "interval": 1,
    "tooltip": true,
    "return-type": "json",
    "on-click-right": "boxpigma msg mode",
    "on-scroll-up": "boxpigma msg volume +5",
    "on-scroll-down": "boxpigma msg volume -5",
    "format": "{}"
  },
  "custom/boxpigma#like": {
    "exec": "~/.config/waybar/scripts/boxpigma --icon like",
    "interval": 1,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/boxpigma --like",
    "on-scroll-up": "boxpigma msg volume +5",
    "on-scroll-down": "boxpigma msg volume -5",
    "format": "{}"
  },
  "custom/boxpigma#prev": {
    "exec": "~/.config/waybar/scripts/boxpigma --icon prev",
    "interval": "once",
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/boxpigma --previous",
    "on-scroll-up": "boxpigma msg volume +5",
    "on-scroll-down": "boxpigma msg volume -5",
    "format": "{}"
  },
  "custom/boxpigma#play": {
    "exec": "~/.config/waybar/scripts/boxpigma --icon play",
    "interval": 1,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/boxpigma --toggle",
    "on-scroll-up": "boxpigma msg volume +5",
    "on-scroll-down": "boxpigma msg volume -5",
    "format": "{}"
  },
  "custom/boxpigma#next": {
    "exec": "~/.config/waybar/scripts/boxpigma --icon next",
    "interval": "once",
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/boxpigma --next",
    "on-scroll-up": "boxpigma msg volume +5",
    "on-scroll-down": "boxpigma msg volume -5",
    "format": "{}"
  }
}
